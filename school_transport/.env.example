# Copy this file to .env (or set these as real environment variables on your
# hosting platform) before running in production. Never commit real secrets.

# A long, random, secret string used to sign session cookies.
SECRET_KEY=change-this-to-a-long-random-value

# Marks the environment as production so secure cookie flags are enabled
# (requires the app to be served over HTTPS).
FLASK_ENV=production

# Optional: absolute path to the SQLite database file. Defaults to
# school_transport.db inside the project folder if not set.
# DATABASE_PATH=/data/school_transport.db
